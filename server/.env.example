# USCityLink server — copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# Required = the server won't work without it. Optional = has a default or turns a feature off.

# ─── Server ────────────────────────────────────────────────────────────────────────────────────
PORT=4300                                   # Required. HTTP + Socket.IO port
JWT_SECRET=change-me-long-random-string     # Required. Signs login tokens (openssl rand -hex 32)
# "local" = use 127.0.0.1 for Redis (development). Anything else uses REDIS_HOST.
DB_SERVER=local

# ─── Main database (MySQL) ─────────────────────────────────────────────────────────────────────
DB_PRIMARY_HOST=127.0.0.1                   # Required
DB_PRIMARY_NAME=uscitylink                  # Required
DB_PRIMARY_USER=root                        # Required
DB_PRIMARY_PASSWORD=

# ─── Yard database (MySQL, yard_management) — trucks, trailers, routes, equipment sync ─────────
DB_SECONDARY_HOST=127.0.0.1                 # Required
DB_SECONDARY_NAME=yard_management           # Required
DB_SECONDARY_USER=root                      # Required
DB_SECONDARY_PASSWORD=

# ─── Redis (queues: notifications, document analysis, groups) ──────────────────────────────────
REDIS_HOST=127.0.0.1                        # Used when DB_SERVER is not "local"
REDIS_PORT=6379
# Currently NOT used: the password is switched off in src/redis.ts because Redis on the servers has
# none. To enable: set requirepass in redis.conf and read process.env.REDIS_PASSWORD there again.
# REDIS_PASSWORD=

# ─── File storage (AWS S3) — chat media, documents ─────────────────────────────────────────────
AWS_REGION=us-west-1                        # Required for uploads
AWS_ACCESS_KEY_ID=                          # Required for uploads
AWS_SECRET_ACCESS_KEY=                      # Required for uploads
BUCKET_NAME=                                # Required for uploads

# ─── Email (SendGrid) — OTP codes, new passwords ───────────────────────────────────────────────
SEND_GRID=SG.xxxxxxxx                       # Required for email OTP. Key needs "Mail Send" permission
SEND_EMAIL=no-reply@example.com             # Required. Must be a verified sender in SendGrid

# ─── SMS (TextRequest) — phone OTP codes ───────────────────────────────────────────────────────
TEXT_REQUEST_API_KEY=                       # Required for phone OTP

# ─── Maps / fleet ──────────────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=                      # Address search (fuel stations, routes)
SAMSARA_API_KEY=                            # Truck GPS / HOS from Samsara

# ─── Push notifications ────────────────────────────────────────────────────────────────────────
# Firebase (Android + iOS chat notifications, Android incoming calls) is configured by the file
# config/firebase.json (service account), not by env variables.

# ─── Automation / document AI (Anthropic) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                          # Required for document reading / flows
AUTOMATION_ENABLED=true                     # false = turn the whole automation module off
# AI_MODEL=claude-opus-5-5                  # Default model for the full document read (also set in the web panel)
# AI_PRECHECK_MODEL=claude-haiku-5-5        # Quick "which document is this" check
# AI_MONTHLY_BUDGET_USD=                    # Shown as the budget line on the usage report
# AI_MAX_EXAMPLES_PER_TYPE=2                # Examples sent per document type
# AI_MAX_EXAMPLES_TOTAL=12
# AUTOMATION_TIMEZONE=America/Los_Angeles   # For time-based flow conditions
# AUTOMATION_BOT_PROFILE_ID=                # Profile that "Dispatch Assistant" messages are sent as
AUTOMATION_WEBHOOK_SECRET=change-me         # Signs outgoing webhooks (X-USCityLink-Signature)

# ─── Voice calls — see docs/calls/README.md ────────────────────────────────────────────────────
# TURN relay (coturn on the AWS server). Needed for drivers on mobile data; without it some calls
# connect with no audio. Same secret as static-auth-secret in /etc/turnserver.conf.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=change-me-long-random-string    # openssl rand -hex 32
# TURN_TTL_SEC=21600                        # TURN credential lifetime (6 h)
# STUN_URLS=stun:stun.l.google.com:19302    # Default: Google's public STUN

# iOS incoming calls when the app is closed (APNs VoIP push → full-screen CallKit, like WhatsApp).
# Apple Developer → Certificates, IDs & Profiles → Keys → "+" → enable "Apple Push Notifications
# service (APNs)" → download the .p8 (only once!) and put it in config/.
APNS_KEY_PATH=/var/www/html/uscitylink/server/config/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX                      # 10 characters, shown next to the key
APNS_TEAM_ID=YYYYYYYYYY                     # Membership → Team ID
APNS_BUNDLE_ID=com.uscitylinkcorp.uscitylink
APNS_PRODUCTION=false                       # false = builds run from Xcode; true = TestFlight / App Store
